# Codiv / OpenJEV System One
CODIV_API_KEY=sk-codiv-REPLACE_WITH_YOUR_KEY
# Optional extra keys (comma-separated). Each 0.3s game call uses the next key (1st call key1, 2nd call key2, …).
# One in-flight Codiv request per key; 429 cools only that key.
CODIV_API_KEYS=sk-codiv-KEY1,sk-codiv-KEY2,sk-codiv-KEY3,sk-codiv-KEY4
CODIV_URL=https://api.codiv.ai/v1/systemone
# Fast loop model (Laya ~10ms). Use openjev-0.1 for heavier reasoning.
CODIV_MODEL=laya-1.0
# Fallback if Laya unavailable
CODIV_MODEL_FALLBACK=openjev-0.1
HOST=127.0.0.1
PORT=8787
REQUEST_TIMEOUT_S=3.5
CODIV_KEY_COOLDOWN_S=20
# How hard to trust Jev confidence: strict_confidence | soft_confidence | follow_jev | planner_only
JEV_TRUST=follow_jev
